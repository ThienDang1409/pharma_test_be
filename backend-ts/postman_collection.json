                                    "options": {"raw": {"language": "json"}}
                                },
                                "url": {
                                    "raw": "{{baseUrl}}/api/auth/refresh-token",
                                    "host": ["{{baseUrl}}"],
                                    "path": ["api", "auth", "refresh-token"]
                                }
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "Blog",
            "item": [
                {
                    "name": "Success Cases",
                    "item": [
                        {
                            "name": "Get All Blogs",
                            "request": {
                                "method": "GET",
                                "url": {
                                    "raw": "{{baseUrl}}/api/blog?page=1&limit=10&status=published",
                                    "host": ["{{baseUrl}}"],
                                    "path": ["api", "blog"],
                                    "query": [
                                        {"key": "page", "value": "1"},
                                        {"key": "limit", "value": "10"},
                                        {"key": "status", "value": "published"}
                                    ]
                                }
                            }
                        },
                        {
                            "name": "Create Blog with Image",
                            "request": {
                                "auth": {
                                    "type": "bearer",
                                    "bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]
                                },
                                "method": "POST",
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n  \"title\": \"Bài viết có ảnh {{$timestamp}}\",\n  \"informationId\": \"65a000000000000000000001\",\n  \"image\": \"{{lastImageId}}\",\n  \"status\": \"published\",\n  \"slug\": \"bai-viet-co-anh-{{$timestamp}}\"\n}",
                                    "options": {"raw": {"language": "json"}}
                                },
                                "url": {
                                    "raw": "{{baseUrl}}/api/blog",
                                    "host": ["{{baseUrl}}"],
                                    "path": ["api", "blog"]
                                }
                            }
                        }
                    ]
                },
